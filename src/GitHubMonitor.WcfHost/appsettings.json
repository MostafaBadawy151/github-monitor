{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Quartz": "Warning",
      "CoreWCF": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5100",
  "GitHub": {
    "ApiBaseUrl": "https://api.github.com/",
    "Owner": "company",
    "Repository": "integration-task-private-repo",
    "Token": "",
    "UserAgent": "IntegrationTaskApp",
    "CommitCount": 10,
    "TimeoutSeconds": 15
  },
  "Scheduler": {
    "IntervalSeconds": 60,
    "CacheFilePath": "App_Data/commits-cache.json"
  }
}
